{
  "name": "Brain Extraction (FSL BET)",
  "github": "gamorosino/app-brain-extraction",
  "github_branch": "main",
  "desc": "Skull-strip a T1w volume using FSL BET. Supports robust centre estimation (-R) and bias-field + neck cleanup (-B).",
  "config": {
    "t1": {
      "type": "input",
      "file_id": "t1",
      "input_id": "t1"
    },
    "frac": {
      "id": "frac",
      "type": "number",
      "placeholder": "0.5",
      "advanced": false,
      "desc": "BET fractional intensity threshold (0\u20131). Lower values give a larger brain mask.",
      "default": 0.5
    },
    "robust": {
      "id": "robust",
      "type": "boolean",
      "placeholder": "",
      "advanced": false,
      "desc": "Use robust brain centre estimation (-R). Slower but more reliable for unusual head shapes.",
      "default": false
    },
    "bias_neck_cleanup": {
      "id": "bias_neck_cleanup",
      "type": "boolean",
      "placeholder": "",
      "advanced": false,
      "desc": "Bias-field correction + neck cleanup (-B).",
      "default": false
    }
  },
  "inputs": [
    {
      "id": "t1",
      "desc": "T1-weighted anatomical image to skull-strip.",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "advanced": false
    }
  ],
  "outputs": [
    {
      "id": "t1_brain",
      "desc": "Brain-extracted T1w volume produced by FSL BET.",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [
        "brain_extracted"
      ],
      "archive": true
    }
  ]
}
